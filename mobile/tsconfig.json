{
	"extends": "@tsconfig/react-native/tsconfig.json",
	"compilerOptions": {
		"resolveJsonModule": true,
		"target": "es6",
		"module": "commonjs",
		"strict": true,
		"jsx": "react",
		"esModuleInterop": true,
		"baseUrl": ".",
		"paths": {
			"@api/*": [
				"./src/api/*"
			],
			"@screens/*": [
				"./src/screens/*"
			],
			"@components/*": [
				"./src/components/*"
			],
			"@navigation/*": [
				"./src/navigation/*"
			],
			"@assets/*": [
				"./src/assets/*"
			],
			"@redux/*": [
				"./src/redux/*"
			],
			"@hooks/*": [
				"./src/hooks/*"
			],
			"@utils/*": [
				"./src/utils/*"
			]
		},
		"types": [
			"node"
		],
		"skipLibCheck": true
	},
	"include": [
		"src",
		"src"
	]
}